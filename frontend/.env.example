# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 칼럼(articles) 섹션 공개 여부 ───────────────────────────
# 미설정 시 비공개(fail closed). 다시 열려면 'true' + 재배포
# + supabase/articles-reopen.sql 실행이 함께 필요하다.
NEXT_PUBLIC_ARTICLES_ENABLED=

# ── 사이트 전체 암호 게이트 ─────────────────────────────────
# 게이트를 다시 켜려면 SITE_GATE_ENABLED=true 를 설정하고 재배포한다.
# 게이트가 켜져 있을 때 프로덕션에서 아래 비밀번호나 시크릿이 없으면 503.
SITE_GATE_ENABLED=false
#
# GATE_SECRET 생성 예:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# NEXT_PUBLIC_ 접두사가 없으므로 브라우저 번들에 포함되지 않는다.
SITE_PASSWORD=
GATE_SECRET=
